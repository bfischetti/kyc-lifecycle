# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=postgres-dev-only
KYC_OWNER_PASSWORD=owner-dev-only
KYC_APP_PASSWORD=app-dev-only
# Host port; change if something else already listens on 5432.
POSTGRES_PORT=5432

# --- Evidence Vault (docker compose: RustFS, S3-compatible) ---
VAULT_ACCESS_KEY=vault-dev-only
VAULT_SECRET_KEY=vault-dev-only-secret
VAULT_BUCKET=evidence
# Host port; change if something else already listens on 9000.
VAULT_PORT=9000

# --- Server ---
# Runtime connection: the non-owner kyc_app role (RLS applies).
DATABASE_URL=postgres://kyc_app:app-dev-only@localhost:5432/kyc?sslmode=disable
# Migration connection: the kyc_owner role.
MIGRATE_DATABASE_URL=postgres://kyc_owner:owner-dev-only@localhost:5432/kyc?sslmode=disable
HTTP_ADDR=:8080
# Evidence Vault as seen by upload clients (presigned URLs are signed for this host).
VAULT_ENDPOINT=http://localhost:9000
UPLOAD_URL_TTL=15m
# How long an Evidence Access download link works.
EVIDENCE_URL_TTL=60s
# Upper bound on each Screening Provider call.
PROVIDER_TIMEOUT=5s
# Background work (disable both with `server serve --worker=false`):
# notification delivery and expiry of abandoned Upload Intents.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_MAX_ATTEMPTS=10
UPLOAD_SWEEP_INTERVAL=1m
LOG_LEVEL=info
